{
  "type": "module",
  "name": "@airis/airis-swarm-extension",
  "version": "17.2.1",
  "description": "Swarm orchestration extension for airis",
  "homepage": "https://airis.sh",
  "author": "Derek Rynd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sufiyan-sabeel/Alpha-AIRIS-CLI.git",
    "directory": "packages/swarm-extension"
  },
  "bugs": {
    "url": "https://github.com/sufiyan-sabeel/Alpha-AIRIS-CLI/issues"
  },
  "keywords": [
    "swarm",
    "orchestration",
    "agent",
    "extension"
  ],
  "bin": {
    "airis-swarm": "src/cli.ts"
  },
  "scripts": {
    "check": "biome check . && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "fix": "biome check --write --unsafe .",
    "fmt": "biome format --write ."
  },
  "dependencies": {
    "@airis/airis-utils": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  },
  "peerDependencies": {
    "@airis/airis-coding-agent": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "airis": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ]
}
