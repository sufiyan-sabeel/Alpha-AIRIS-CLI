# syntax=docker/dockerfile:1.7-labs
###############################################################################
# roboairis — GitHub triage+fix bot orchestrator.
#
# Extends `airis-base` (from /Dockerfile, default target airis/airis:dev) and adds
# the roboairis Python package + a Vite-built SolidJS dashboard bundle. The pi
# toolchain (python + bun + rustup launcher + airis-natives + airis_rpc wheel +
# /usr/local/bin/airis.shim) all comes from AIRIS_BASE; this file only layers what's
# roboairis-specific.
#
# Build (from airis root):
#     bun run airis:image                              # build airis/airis:dev first
#     docker build -f Dockerfile.roboairis -t roboairis:dev .
#
# Compose (recommended):
#     docker compose --project-directory python/roboairis build
###############################################################################

ARG AIRIS_BASE=airis/airis:dev
ARG BUN_VERSION=1.3.14

############################
# 1) web-builder — Bun + Vite, builds the SolidJS dashboard bundle.
############################
FROM oven/bun:${BUN_VERSION}-slim AS web-builder
WORKDIR /work
# Root manifests + the web workspace manifest are enough for `bun install
# --filter roboairis-web` to hydrate just the dashboard's node_modules.
COPY package.json bun.lock ./
COPY python/roboairis/web/package.json ./python/roboairis/web/package.json
# Root package.json declares patchedDependencies, so the patch file must be
# present before any root-level `bun install` (even a filtered one).
COPY patches/*.patch ./patches/
RUN bun install --filter roboairis-web
COPY --exclude=node_modules --exclude=dist python/roboairis/web/ ./python/roboairis/web/
RUN bun --cwd=python/roboairis/web run build

############################
# 2) runtime — airis-base + roboairis src + web bundle + pip install
############################
FROM ${AIRIS_BASE} AS runtime

# roboairis runs against the host airis checkout mounted at /work/pi read-only.
ENV AIRIS_ROOT=/work/airis

WORKDIR /app

# roboairis itself. Drop the Vite-built dashboard into the package tree before
# `pip install` so it lands in the installed wheel (`static/**/*` is declared
# as package-data in pyproject.toml).
COPY python/roboairis/pyproject.toml ./
COPY python/roboairis/src/ ./src/
COPY --from=web-builder /work/python/roboairis/web/dist/ ./src/static/

RUN pip install --no-cache-dir \
        "fastapi>=0.112" "uvicorn[standard]>=0.30" "httpx>=0.27" \
        "pydantic>=2.6" "pydantic-settings>=2.2" "python-dotenv>=1.0" \
        "click>=8.1" \
    && pip install --no-cache-dir --no-deps .

# Host agent config is mounted read-only under /srv/agent-home-stage with
# host-controlled permissions. The entrypoint copies it into root-owned
# world-readable files under /srv/agent-home; the agent subprocess runs with
# HOME=/srv/agent-home, so ~/.airis and ~/.agent resolve there without exposing
# mutable host mounts.
RUN mkdir -p /srv/agent-home/.agent /srv/agent-home/.airis/agent \
    && mkdir -p /srv/agent-home-stage/.agent /srv/agent-home-stage/.airis/agent \
    && printf '[install]\nbackend = "copyfile"\n' > /srv/agent-home/.bunfig.toml

COPY python/roboairis/entrypoint.sh /usr/local/bin/roboairis-entrypoint
RUN chmod +x /usr/local/bin/roboairis-entrypoint

VOLUME ["/data"]
EXPOSE 8080
EXPOSE 8081

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/roboairis-entrypoint"]
CMD ["python", "-m", "roboairis", "serve"]
